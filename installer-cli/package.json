{
  "name": "weegloo",
  "version": "1.1.0",
  "description": "CLI to set up the Weegloo MCP plugin for Cursor, Claude Code, Codex, Antigravity, and Android Studio (interactive or non-interactive)",
  "type": "module",
  "bin": {
    "weegloo": "dist/bin.js"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
