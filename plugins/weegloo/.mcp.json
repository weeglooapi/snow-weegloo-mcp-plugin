{
  "mcpServers": {
    "weegloo": {
      "type": "http",
      "url": "https://ai.sn-weegloo.com/mcp"
    },
    "weegloo-upload": {
      "command": "npx",
      "args": [
        "-y",
        "--registry=https://artifactory.navercorp.com/artifactory/api/npm/npm-local/",
        "weegloo-upload"
      ],
      "env": {
        "UPLOAD_API_URL": "https://upload.sn-weegloo.com/v1",
        "AUTH_BEARER_TOKEN": "${PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
